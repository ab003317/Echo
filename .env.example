# Echo — 複製為 .env 後修改 / Copy to .env and edit.
# 網域填主機名稱，不加 https:// 或路徑 / Hostname only, no scheme or path.
DOMAIN=music.example.com
# 預設自動 HTTPS；已有反向代理請清空此值 / Automatic HTTPS; leave blank for an existing proxy.
COMPOSE_PROFILES=https
# 主機上的音樂目錄；會寫入新歌 / Host music directory; imported music is written here.
MUSIC_PATH=./music
TZ=Asia/Hong_Kong
BIND_ADDRESS=127.0.0.1
HTTP_PORT=18082

# 官方預設 / Official presets: gemini | openai | deepseek | qwen
# 其他 OpenAI Chat Completions 相容渠道 / Other compatible endpoints: custom
# 關閉 AI / Disable AI: none
AI_PROVIDER=gemini
# 留空採用渠道預設；custom、qwen 必填 / Preset if blank; required for custom and qwen.
# 相容 URL 填到 /v1（視渠道而定），不要加 /chat/completions。
# Enter the API base (often ending in /v1), without /chat/completions.
AI_BASE_URL=
AI_MODEL=
# 單組 key 可直接填；多組必須使用 JSON 字串陣列，不可用逗號隨意拼接。
# A single key is accepted; multiple keys MUST be a JSON array of strings.
# 同一池只放同渠道、同端點的 key；重複 key 會去除。
# One provider/endpoint per pool; duplicates are removed.
# 單組 / One: AI_API_KEYS=your-key
# 多組 / Multiple: AI_API_KEYS='["first-key","second-key","third-key"]'
# 外層單引號保護 $ 等字元不被 Compose 展開 / Outer single quotes protect literal $ characters.
AI_API_KEYS='[]'

# 是否需要 VPN／代理由伺服器所在地、網路與渠道支援地區決定，不是只看模型名稱。
# VPN/proxy needs depend on server location, routing and provider availability, not just the model.
# OpenAI/Gemini 有地區限制；代理不等於取得不支援地區的服務資格。
# OpenAI/Gemini have regional restrictions; a proxy does not change account eligibility.
# DeepSeek/Qwen 通常可在中國大陸直連；Qwen key 與 URL 地區必須一致。
# DeepSeek/Qwen are commonly reachable from mainland China; Qwen keys and URLs must share a region.
# 可選 HTTP(S) 代理；容器內 127.0.0.1 是容器本身。
# Optional HTTP(S) proxy; 127.0.0.1 inside Docker refers to the container itself.
# 範例 / Example: http://host.docker.internal:7890
AI_PROXY_URL=

# 音訊分析獨立設定 / Separate audio-analysis configuration.
# auto：Gemini 使用同模型；OpenAI 使用 gpt-audio-1.5；其他渠道停用音訊。
# auto: Gemini uses the same model; OpenAI uses gpt-audio-1.5; others disable audio.
# 不支援音訊時只分析聆聽行為，絕不從歌名猜曲風。
# Without audio input, only listening behavior is analyzed; titles never imply genre.
# 可選 / Options: auto | none | gemini | openai | custom
AUDIO_AI_PROVIDER=auto
AUDIO_AI_BASE_URL=
AUDIO_AI_MODEL=
# 同渠道且同 URL 才繼承 AI_API_KEYS；不同渠道需另填。
# Inherits AI_API_KEYS only for the same provider AND URL; otherwise supply separate keys.
AUDIO_AI_API_KEYS=
AUDIO_AI_PROXY_URL=

# YouTube 連線代理與 AI 分開 / YouTube routing is separate from AI routing.
YOUTUBE_PROXY_URL=
# 可選 Netscape cookies 檔案：放 ./cookies.txt，另見 docs。
# Optional Netscape cookies file: place at ./cookies.txt; see docs for the volume mount.
YOUTUBE_COOKIES_FILE=
